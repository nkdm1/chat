# Copy to .env and fill in. Never commit .env.
# Every value below is for local development. In Azure, non-secret values come
# from a ConfigMap and secrets from Key Vault (see docs/azure-deployment.md).

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://chat:chat@localhost:5432/chat

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app. Used for cookies, CSRF origin checks and e-mail links.
BETTER_AUTH_URL=http://localhost:3000

# Email: "smtp" (Mailpit in dev: UI on http://localhost:8025) or "acs" (Azure).
EMAIL_PROVIDER=smtp
MAIL_FROM="chat <no-reply@chat.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# ACS (Azure): ACS_ENDPOINT + managed identity, or ACS_CONNECTION_STRING.
ACS_ENDPOINT=
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=

REDIS_URL=redis://localhost:6379

# Creates the Cosmos database/container and the blob container if missing.
# Local emulators only. Keep false in Azure (OpenTofu creates them).
AUTO_PROVISION=true

# --- Azure services --------------------------------------------------------
# Locally: the emulators from docker-compose, via *_CONNECTION_STRING.
# The keys below are the public, documented emulator keys, not secrets.
# In Azure: unset *_CONNECTION_STRING and set *_ENDPOINT / *_ACCOUNT_URL;
# the app then authenticates with managed identity (no keys).

COSMOS_CONNECTION_STRING=AccountEndpoint=http://localhost:8081/;AccountKey=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==;
COSMOS_ENDPOINT=
COSMOS_DATABASE=chat
COSMOS_MESSAGES_CONTAINER=messages

WEBPUBSUB_CONNECTION_STRING=Endpoint=http://localhost:8085;AccessKey=ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABCDEFGH;Version=1.0;
WEBPUBSUB_ENDPOINT=
WEBPUBSUB_HUB=chat
# Optional: origin browsers connect to (derived from the endpoint when empty).
WEBPUBSUB_CLIENT_ORIGIN=

AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=attachments
