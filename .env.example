# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://chat:chat@localhost:5432/chat

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app. Used for cookies, CSRF origin checks and e-mail links.
BETTER_AUTH_URL=http://localhost:3000

# SMTP (Mailpit in dev: UI on http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="chat <no-reply@chat.local>"
